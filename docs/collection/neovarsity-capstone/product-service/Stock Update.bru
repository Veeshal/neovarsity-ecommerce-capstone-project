meta {
  name: Stock Update
  type: http
  seq: 4
}

put {
  url: {{base-url}}{{context}}/v1/product/stock
  body: json
  auth: inherit
}

body:json {
  {
    "productId": "1",
    "quantity": "-5"
  }
}


meta {
  name: Delete Cart Item
  type: http
  seq: 3
}

delete {
  url: {{base-url}}{{context}}/v1/cart/items/:productId?userId=1
  body: json
  auth: inherit
}

params:query {
  userId: 1
}

params:path {
  productId: 1
}

body:json {
  {
    "productId": 3,
    "quantity": 1,
    "userId": 1
  }
}
